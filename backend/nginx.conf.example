# Astras Search Nginx 反向代理配置
# 部署前请修改 server_name 和 SSL 证书路径

upstream astras_backend {
    server localhost:3000;
    keepalive 32;
}

# HTTP 重定向到 HTTPS
server {
    listen 80;
    server_name search.astras.example api.search.astras.example;
    return 301 https://$server_name$request_uri;
}

# 前端静态页面
server {
    listen 443 ssl http2;
    server_name search.astras.example;

    # SSL 证书（请替换为真实路径）
    ssl_certificate /etc/nginx/ssl/search.astras.example.crt;
    ssl_certificate_key /etc/nginx/ssl/search.astras.example.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers 'ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256';
    ssl_prefer_server_ciphers on;

    # 安全头
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://api.search.astras.example;" always;

    # 静态文件缓存
    location ~* \.(html|htm)$ {
        root /var/www/astras-search;
        expires -1;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }

    location ~* \.(ico|css|js|png|jpg|jpeg|gif|svg|woff|woff2)$ {
        root /var/www/astras-search;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        root /var/www/astras-search;
        try_files $uri $uri/ /index.html;
    }

    # 错误页面
    error_page 404 /index.html;
    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /var/www/astras-search;
    }
}

# 后端 API 代理
server {
    listen 443 ssl http2;
    server_name api.search.astras.example;

    ssl_certificate /etc/nginx/ssl/api.search.astras.example.crt;
    ssl_certificate_key /etc/nginx/ssl/api.search.astras.example.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    # 速率限制
    limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;
    limit_req zone=api burst=20 nodelay;

    location / {
        proxy_pass http://astras_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_send_timeout 10s;
        proxy_read_timeout 10s;
    }
}
