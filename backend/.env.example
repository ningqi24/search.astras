# Astras Search 后端环境变量配置
# 复制此文件为 .env 并填入真实值

# 服务器配置
PORT=3000
NODE_ENV=production
ALLOWED_ORIGINS=https://search.astras.example,http://localhost:8080

# Google Custom Search API
# 获取方式：https://developers.google.com/custom-search/v1/overview
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CX=your_search_engine_id_here

# Bing Web Search API
# 获取方式：https://www.microsoft.com/en-us/bing/apis/bing-web-search-api
BING_API_KEY=your_bing_api_key_here

# 注意：
# 1. 不要将 .env 文件提交到 Git 仓库（已加入 .gitignore）
# 2. 生产环境建议使用密钥管理服务（如 AWS Secrets Manager、Azure Key Vault）
